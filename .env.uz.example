# Environment for the uz.docai.az instance (project: docai-uz).
# Copy to .env in /home/docai-uz and fill the *** secrets with values
# UNIQUE to this instance (do NOT reuse the docai.az DB/MinIO/JWT secrets).
#
# Note: DATABASE_URL / REDIS_URL / MINIO_ENDPOINT below are overridden by
# docker-compose.yml to the in-network service names (postgres/redis/minio),
# so the host references here only matter for non-Docker tooling.

# Database — generate a fresh password: openssl rand -hex 16
DATABASE_URL=postgresql+asyncpg://aidms:***@localhost:5432/aidms
POSTGRES_PASSWORD=***

# Redis
REDIS_URL=redis://localhost:6379

# MinIO — generate a fresh secret: openssl rand -hex 16
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=***
MINIO_BUCKET_NAME=documents
MINIO_SECURE=false

# Google Cloud Vision (same GCP project/credentials as docai.az)
GOOGLE_CLOUD_CREDENTIALS=/run/secrets/gcp.json
GOOGLE_CLOUD_PROJECT=alert-parsec-413511

# OpenAI (shared key OK)
OPENAI_API_KEY=***

# Anthropic (shared key OK)
ANTHROPIC_API_KEY=***

# JWT — MUST be unique so tokens are not cross-valid between instances:
#   openssl rand -hex 32
JWT_SECRET=***
JWT_EXPIRY_MINUTES=30
JWT_REFRESH_EXPIRY_DAYS=7

# App
CORS_ORIGINS=["https://uz.docai.az"]
ENVIRONMENT=production
LOG_LEVEL=WARNING
MAX_UPLOAD_SIZE_MB=50

# Email (SMTP) — reuse or use a uz-specific sender
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="***"
SMTP_PASS="***"
SMTP_FROM="info@docai.az"
